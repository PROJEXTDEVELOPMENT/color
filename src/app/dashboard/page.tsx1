// app/dashboard/page.tsx
"use client";

import { useEffect, useMemo, useState, useRef } from "react";
import { useRouter } from "next/navigation";
import { supabase } from "@/lib/supabaseClient";
import { Menu, X, Wallet, History, UserCheck, LogOut, Wifi, Zap, TrendingUp, Database, Shield, CreditCard, ArrowUpRight } from "lucide-react";

type StoredUser = {
  id?: string;
  mobile?: string;
  email?: string;
  full_name?: string;
};

export default function DashboardPage() {
  const router = useRouter();
  const [loading, setLoading] = useState(true);
  const [storedUser, setStoredUser] = useState<StoredUser | null>(null);
  const [profile, setProfile] = useState<{ balance: number; full_name?: string; mobile?: string; operator?: string } | null>(null);
  const [usersCount, setUsersCount] = useState<number>(0);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [savingToDB, setSavingToDB] = useState(false);
  const [lastSavedAmount, setLastSavedAmount] = useState<number>(0);

  // Data selling simulation state
  const [selling, setSelling] = useState(false);
  const [mbSold, setMbSold] = useState<number>(0);
  const [moneyEarned, setMoneyEarned] = useState<number>(0);
  const [netSpeed, setNetSpeed] = useState<number>(0);
  const intervalRef = useRef<number | null>(null);

  // Rate per MB (₹) - Higher for urgency
  const RATE_PER_MB = 0.25; // Increased rate for more urgency

  // Initialize and load user data
  useEffect(() => {
    const initializeDashboard = async () => {
      try {
        // Try localStorage first (custom login)
        const raw = localStorage.getItem("user");
        if (raw) {
          const parsed: StoredUser = JSON.parse(raw);
          setStoredUser(parsed);
          await loadProfile(parsed);
          setLoading(false);
          await fetchUsersCount();
          return;
        }

        // Fallback to Supabase Auth
        const { data } = await supabase.auth.getUser();
        const authUser = data?.user;
        if (authUser) {
          const parsed: StoredUser = { 
            id: authUser.id, 
            email: authUser.email ?? undefined 
          };
          setStoredUser(parsed);
          await loadProfile(parsed);
          setLoading(false);
          await fetchUsersCount();
          return;
        }

        // Not logged in → redirect
        router.replace("/login");
      } catch (err) {
        console.error("Dashboard init error:", err);
        setLoading(false);
      }
    };

    initializeDashboard();

    return () => {
      stopSellingInterval();
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Load user profile from database
  async function loadProfile(user: StoredUser) {
    if (!user) return;
    
    try {
      let query = supabase.from("users").select("balance, full_name, mobile, operator");
      
      if (user.id) {
        query = query.eq("id", user.id);
      } else if (user.mobile) {
        query = query.eq("mobile", user.mobile);
      } else if (user.email) {
        query = query.eq("email", user.email);
      }
      
      const { data, error } = await query.single();
      
      if (!error && data) {
        setProfile({ 
          balance: Number(data.balance ?? 0), 
          full_name: data.full_name, 
          mobile: data.mobile, 
          operator: data.operator 
        });
      } else {
        // Create new profile if doesn't exist
        if (user.email || user.mobile) {
          const { data: newUser } = await supabase
            .from("users")
            .upsert({
              email: user.email,
              mobile: user.mobile,
              balance: 0,
              created_at: new Date().toISOString()
            })
            .select()
            .single();
            
          if (newUser) {
            setProfile({ 
              balance: 0, 
              full_name: newUser.full_name, 
              mobile: newUser.mobile, 
              operator: newUser.operator 
            });
          }
        }
      }
    } catch (err) {
      console.error("loadProfile error", err);
    }
  }

  // Fetch live users count
  async function fetchUsersCount() {
    try {
      const { count, error } = await supabase
        .from("users")
        .select("*", { count: "exact", head: true });
        
      if (!error && typeof count === "number") {
        setUsersCount(count);
      }
      
      // Poll every 30 seconds for updated count
      const pollInterval = setInterval(async () => {
        const { count: newCount } = await supabase
          .from("users")
          .select("*", { count: "exact", head: true });
          
        if (typeof newCount === "number") {
          setUsersCount(newCount);
        }
      }, 30000);
      
      return () => clearInterval(pollInterval);
    } catch (err) {
      console.warn("count fetch err", err);
    }
  }

  // Update operator in database
  async function changeOperator(op: string) {
    if (!storedUser) return;
    
    setProfile((p) => (p ? { ...p, operator: op } : { balance: 0, operator: op }));
    
    try {
      let updateQuery = supabase.from("users").update({ operator: op });
      
      if (storedUser.id) {
        updateQuery = updateQuery.eq("id", storedUser.id);
      } else if (storedUser.mobile) {
        updateQuery = updateQuery.eq("mobile", storedUser.mobile);
      } else if (storedUser.email) {
        updateQuery = updateQuery.eq("email", storedUser.email);
      }
      
      await updateQuery;
    } catch (err) {
      console.warn("update operator err", err);
    }
  }

  // Save earned money to database
  async function saveEarningsToDB(earnedAmount: number) {
    if (!storedUser || earnedAmount <= 0) return;
    
    setSavingToDB(true);
    
    try {
      // First get current balance
      let selectQuery = supabase.from("users").select("balance");
      
      if (storedUser.id) {
        selectQuery = selectQuery.eq("id", storedUser.id);
      } else if (storedUser.mobile) {
        selectQuery = selectQuery.eq("mobile", storedUser.mobile);
      } else if (storedUser.email) {
        selectQuery = selectQuery.eq("email", storedUser.email);
      }
      
      const { data: currentData, error: selectError } = await selectQuery.single();
      
      if (selectError) throw selectError;
      
      const currentBalance = Number(currentData?.balance ?? 0);
      const newBalance = Number((currentBalance + earnedAmount).toFixed(2));
      
      // Update balance in database
      let updateQuery = supabase.from("users").update({ balance: newBalance });
      
      if (storedUser.id) {
        updateQuery = updateQuery.eq("id", storedUser.id);
      } else if (storedUser.mobile) {
        updateQuery = updateQuery.eq("mobile", storedUser.mobile);
      } else if (storedUser.email) {
        updateQuery = updateQuery.eq("email", storedUser.email);
      }
      
      const { error: updateError } = await updateQuery;
      
      if (updateError) throw updateError;
      
      // Update local state
      setProfile((p) => (p ? { ...p, balance: newBalance } : { balance: newBalance }));
      setLastSavedAmount(earnedAmount);
      
      console.log(`💰 Saved ₹${earnedAmount.toFixed(2)} to DB. New balance: ₹${newBalance.toFixed(2)}`);
      
    } catch (err) {
      console.error("Error saving earnings to DB:", err);
    } finally {
      setSavingToDB(false);
    }
  }

  // Start selling simulation
  function startSelling() {
    if (selling) return;
    
    setSelling(true);
    setMbSold(0);
    setMoneyEarned(0);
    setNetSpeed(0);

    // URGENT MODE: Very high earning simulation
    intervalRef.current = window.setInterval(() => {
      // Very high network speed for urgency: 80-200 Mbps
      const speed = parseFloat((Math.random() * 120 + 80).toFixed(2));
      setNetSpeed(speed);

      // High MB per second for urgent earning (around 20-50 MB/s)
      const mbThisTick = parseFloat((speed * 0.25).toFixed(3));
      
      setMbSold((m) => {
        const next = parseFloat((m + mbThisTick).toFixed(3));
        // Calculate money earned
        const earned = parseFloat((next * RATE_PER_MB).toFixed(2));
        setMoneyEarned(earned);
        return next;
      });
    }, 1000); // Update every second
  }

  // Stop selling and save earnings to database
  async function stopSellingAndSave() {
    stopSellingInterval();
    setSelling(false);
    
    // Save earnings to database
    if (moneyEarned > 0) {
      await saveEarningsToDB(moneyEarned);
    }
    
    // Reset counters
    setMbSold(0);
    setMoneyEarned(0);
    setNetSpeed(0);
  }

  // Stop selling without saving
  function pauseSelling() {
    stopSellingInterval();
    setSelling(false);
    setNetSpeed(0);
  }

  function stopSellingInterval() {
    if (intervalRef.current) {
      window.clearInterval(intervalRef.current);
      intervalRef.current = null;
    }
  }

  // Handle withdraw button click
  function handleWithdraw() {
    router.push("/withdraw");
  }

  // Logout function
  async function handleLogout() {
    try {
      localStorage.removeItem("user");
      await supabase.auth.signOut();
    } catch (err) {
      console.warn(err);
    } finally {
      router.replace("/login");
    }
  }

  // Calculate earnings per second for display
  const earningsPerSecond = useMemo(() => {
    if (!selling) return 0;
    // Calculate based on current MB sold and rate
    return parseFloat((RATE_PER_MB * (netSpeed * 0.25)).toFixed(2));
  }, [selling, netSpeed]);

  if (loading) return (
    <div className="min-h-screen flex items-center justify-center bg-gradient-to-b from-gray-900 to-black">
      <div className="text-center">
        <div className="w-16 h-16 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p className="mt-4 text-gray-300">Loading dashboard...</p>
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-b from-gray-900 to-black text-white p-4 pb-24">
      {/* Mobile Header */}
      <div className="flex items-center justify-between mb-6">
        <div className="flex items-center gap-3">
          <button
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
            className="lg:hidden p-2"
          >
            {mobileMenuOpen ? <X size={24} /> : <Menu size={24} />}
          </button>
          <div className="rounded-full bg-gradient-to-br from-[#0f5087] to-[#0a9bd8] w-10 h-10 flex items-center justify-center">
            <span className="font-bold text-sm">DS</span>
          </div>
          <div>
            <div className="text-lg font-bold">Data Sell Pro</div>
            <div className="text-xs text-gray-400">
              {profile?.full_name?.split(" ")[0] || storedUser?.full_name?.split(" ")[0] || "User"}
            </div>
          </div>
        </div>

        {/* Mobile Menu Overlay */}
        {mobileMenuOpen && (
          <div className="fixed inset-0 z-50 bg-black bg-opacity-90 lg:hidden">
            <div className="p-6">
              <div className="flex justify-between items-center mb-8">
                <div className="text-xl font-bold">Menu</div>
                <button onClick={() => setMobileMenuOpen(false)}>
                  <X size={24} />
                </button>
              </div>
              <div className="space-y-4">
                <button className="flex items-center gap-3 w-full p-3 rounded-lg bg-gray-800">
                  <Wallet size={20} />
                  <span>Wallet</span>
                </button>
                <button className="flex items-center gap-3 w-full p-3 rounded-lg bg-gray-800">
                  <History size={20} />
                  <span>History</span>
                </button>
                <button className="flex items-center gap-3 w-full p-3 rounded-lg bg-gray-800">
                  <UserCheck size={20} />
                  <span>KYC</span>
                </button>
                <button 
                  onClick={handleWithdraw}
                  className="flex items-center gap-3 w-full p-3 rounded-lg bg-green-700"
                >
                  <CreditCard size={20} />
                  <span>Withdraw</span>
                </button>
                <button className="flex items-center gap-3 w-full p-3 rounded-lg bg-gray-800">
                  <Database size={20} />
                  <span>Data History</span>
                </button>
                <button
                  onClick={handleLogout}
                  className="flex items-center gap-3 w-full p-3 rounded-lg bg-red-600"
                >
                  <LogOut size={20} />
                  <span>Logout</span>
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Desktop Menu */}
        <div className="hidden lg:flex items-center gap-2">
          <button className="px-3 py-2 bg-gray-800 rounded-lg text-sm flex items-center gap-2">
            <Wallet size={16} />
            Wallet
          </button>
          <button className="px-3 py-2 bg-gray-800 rounded-lg text-sm flex items-center gap-2">
            <History size={16} />
            History
          </button>
          <button className="px-3 py-2 bg-gray-800 rounded-lg text-sm flex items-center gap-2">
            <UserCheck size={16} />
            KYC
          </button>
          <button
            onClick={handleWithdraw}
            className="px-3 py-2 bg-green-600 rounded-lg text-sm flex items-center gap-2"
          >
            <CreditCard size={16} />
            Withdraw
          </button>
          <button
            onClick={handleLogout}
            className="px-3 py-2 bg-red-600 rounded-lg text-sm flex items-center gap-2"
          >
            <LogOut size={16} />
            Logout
          </button>
        </div>
      </div>

      {/* DB Connection Status */}
      {savingToDB && (
        <div className="mb-4 p-3 bg-blue-900/30 border border-blue-500/30 rounded-lg animate-pulse">
          <div className="flex items-center gap-2">
            <Database size={16} className="text-blue-400" />
            <span className="text-sm font-medium text-blue-300">Saving ₹{moneyEarned.toFixed(2)} to database...</span>
          </div>
        </div>
      )}

      {lastSavedAmount > 0 && !savingToDB && (
        <div className="mb-4 p-3 bg-green-900/30 border border-green-500/30 rounded-lg">
          <div className="flex items-center gap-2">
            <Shield size={16} className="text-green-400" />
            <span className="text-sm font-medium text-green-300">✓ ₹{lastSavedAmount.toFixed(2)} saved to your wallet!</span>
          </div>
        </div>
      )}

      {/* Users Live Count */}
      <div className="bg-gradient-to-r from-[#0b4b66] to-[#155a83] p-5 rounded-xl mb-5 relative overflow-hidden">
        <div className="absolute top-2 right-2">
          <Zap size={20} className="text-yellow-300 animate-pulse" />
        </div>
        <div className="text-center text-3xl font-bold mb-1">{usersCount.toLocaleString()}</div>
        <div className="text-center text-sm text-gray-200">
          Users Live Selling Data Now
        </div>
        <div className="flex items-center justify-center mt-2 gap-1">
          <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
          <span className="text-xs text-green-400">Live</span>
        </div>
      </div>

      {/* Wallet Balance - With Withdraw Button */}
      <div className="bg-gradient-to-r from-[#14a0f0] to-[#29d2ff] p-5 rounded-xl text-black mb-5 relative">
        <div className="flex justify-between items-start mb-4">
          <div>
            <div className="text-lg font-semibold">Wallet Balance</div>
            <div className="text-4xl font-bold mt-1">₹{(profile?.balance ?? 0).toFixed(2)}</div>
          </div>
          
          {/* Withdraw Button */}
          <button
            onClick={handleWithdraw}
            className="flex items-center gap-2 px-4 py-2 bg-black text-white rounded-lg font-medium hover:bg-gray-900 active:scale-95 transition-all duration-200 shadow-lg"
          >
            <CreditCard size={18} />
            <span>Withdraw</span>
            <ArrowUpRight size={16} />
          </button>
        </div>
        
        <div className="flex justify-between items-center">
          <div className="text-sm opacity-80">
            Connected to Database ✓
          </div>
          {selling && (
            <div className="text-right">
              <div className="text-green-700 font-bold animate-pulse">
                +₹{moneyEarned.toFixed(2)}
              </div>
              <div className="text-xs font-semibold">LIVE EARNING</div>
            </div>
          )}
        </div>
      </div>

      {/* Operator Selection */}
      <div className="bg-[#0b1b23] p-4 rounded-xl mb-5">
        <div className="mb-3 font-semibold flex items-center gap-2">
          <Wifi size={18} />
          Select Operator
        </div>
        <div className="grid grid-cols-3 gap-2">
          {["Jio", "Airtel", "Vi", "BSNL", "WiFi", "MTNL"].map((op) => (
            <button
              key={op}
              onClick={() => changeOperator(op)}
              className={`py-3 px-2 rounded-lg border-2 transition-all duration-200 active:scale-95 ${profile?.operator === op
                ? "border-blue-400 bg-[#10232b] shadow-lg shadow-blue-500/20"
                : "border-gray-700 bg-gray-900"
                }`}
            >
              <div className="text-center text-sm font-medium">{op}</div>
            </button>
          ))}
        </div>
      </div>

      {/* Data Selling Card */}
      <div className="bg-[#0b1b23] p-4 rounded-xl">
        <div className="mb-4">
          <h3 className="text-xl font-bold mb-1">Data Selling</h3>
          <p className="text-sm text-gray-400">
            Start selling your data to earn money instantly
          </p>
        </div>

        {/* Network Speed Indicator */}
        <div className="flex items-center justify-between mb-4 p-3 bg-gray-900 rounded-lg">
          <div className="flex items-center gap-2">
            <TrendingUp size={18} className="text-blue-400" />
            <span className="text-sm">Network Speed</span>
          </div>
          <div className="text-right">
            <div className={`text-lg font-bold ${selling ? "animate-pulse text-green-400" : "text-gray-300"}`}>
              {netSpeed.toFixed(2)} Mbps
            </div>
            <div className={`text-xs ${selling ? "text-green-400" : "text-gray-500"}`}>
              {selling ? "HIGH SPEED" : "STOPPED"}
            </div>
          </div>
        </div>

        {/* Urgent Earning Stats */}
        <div className="grid grid-cols-2 gap-3 mb-4">
          <div className="bg-[#081316] p-3 rounded-lg">
            <div className="text-xs text-gray-400 mb-1">MB Sold</div>
            <div className="text-xl font-bold flex items-center gap-1">
              {mbSold.toFixed(2)} MB
              {selling && (
                <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
              )}
            </div>
            {selling && (
              <div className="text-xs text-green-400 mt-1 animate-pulse">
                ▲ Live Selling
              </div>
            )}
          </div>
          <div className="bg-[#081316] p-3 rounded-lg">
            <div className="text-xs text-gray-400 mb-1">Money Earned</div>
            <div className="text-2xl font-bold text-green-400">
              ₹{moneyEarned.toFixed(2)}
            </div>
            {selling && (
              <div className="text-xs text-green-300 mt-1 font-semibold animate-pulse">
                +₹{earningsPerSecond.toFixed(2)}/sec
              </div>
            )}
          </div>
        </div>

        {/* Progress Bar */}
        <div className="w-full h-2 bg-gray-800 rounded-full mb-6 overflow-hidden">
          <div
            style={{ width: `${Math.min(100, (netSpeed / 200) * 100)}%` }}
            className="h-2 bg-gradient-to-r from-green-400 to-blue-500 transition-all duration-300"
          />
        </div>

        {/* Action Buttons */}
        <div className="flex flex-col gap-2">
          {!selling ? (
            <button
              onClick={startSelling}
              className="w-full py-4 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl font-bold text-lg active:scale-95 transition-transform duration-200 shadow-lg shadow-green-500/20"
              disabled={savingToDB}
            >
              {savingToDB ? "SAVING..." : "⚡ START SELLING"}
            </button>
          ) : (
            <>
              <button
                onClick={stopSellingAndSave}
                className="w-full py-4 bg-gradient-to-r from-red-500 to-pink-600 rounded-xl font-bold text-lg active:scale-95 transition-transform duration-200 animate-pulse"
              >
                💰 STOP & SAVE ₹{moneyEarned.toFixed(2)}
              </button>
              <div className="grid grid-cols-2 gap-2">
                <button
                  onClick={pauseSelling}
                  className="py-3 bg-gray-700 rounded-lg font-medium active:scale-95 transition-transform"
                >
                  PAUSE
                </button>
                <button
                  onClick={startSelling}
                  className="py-3 bg-blue-600 rounded-lg font-medium active:scale-95 transition-transform"
                >
                  MAX SPEED
                </button>
              </div>
            </>
          )}
        </div>

        {/* Urgent Notification */}
        {selling && (
          <div className="mt-4 p-3 bg-gradient-to-r from-yellow-900/30 to-orange-900/30 border border-yellow-500/30 rounded-lg">
            <div className="flex items-center gap-2">
              <div className="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></div>
              <span className="text-sm font-semibold text-yellow-300">
                ⚡ URGENT: Earning ₹{earningsPerSecond.toFixed(2)}/second!
              </span>
            </div>
            <div className="text-xs text-yellow-200/70 mt-1">
              Don't stop now! Earnings will be saved to your wallet instantly
            </div>
          </div>
        )}

        {/* DB Info */}
        <div className="mt-4 p-3 bg-gray-900/50 rounded-lg">
          <div className="flex items-center justify-between text-xs">
            <div className="flex items-center gap-1">
              <Database size={12} className="text-blue-400" />
              <span className="text-gray-400">Database:</span>
            </div>
            <span className="text-green-400 font-medium">Connected ✓</span>
          </div>
          <div className="text-xs text-gray-500 mt-1">
            Your earnings are securely saved to cloud database
          </div>
        </div>
      </div>

      {/* Mobile Bottom Info */}
      <div className="fixed bottom-0 left-0 right-0 bg-gray-900 border-t border-gray-800 p-3 lg:hidden">
        <div className="flex justify-between items-center">
          <div className="text-xs text-gray-400">
            Balance: ₹{(profile?.balance ?? 0).toFixed(2)}
          </div>
          <div className="flex items-center gap-2">
            <button
              onClick={handleWithdraw}
              className="flex items-center gap-1 px-3 py-1.5 bg-green-600 rounded-lg text-xs font-medium active:scale-95"
            >
              <CreditCard size={12} />
              Withdraw
            </button>
            <div className="flex items-center gap-1">
              {selling && <div className="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>}
              <span className={`text-xs ${selling ? "text-green-400" : "text-gray-500"}`}>
                {selling ? `+₹${earningsPerSecond.toFixed(2)}/sec` : "Ready"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}