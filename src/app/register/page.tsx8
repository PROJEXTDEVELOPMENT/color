"use client";

import { useState } from "react";
import { supabase } from "@/lib/supabaseClient";
import { useRouter } from "next/navigation";
import { Eye, EyeOff, Shield, CheckCircle, Zap, Wallet, Phone, User, Key } from "lucide-react";

export default function RegisterPage() {
  const router = useRouter();

  const [formData, setFormData] = useState({
    fullName: "",
    mobile: "",
    password: "",
    confirmPassword: "",
    referral: ""
  });
  
  const [errors, setErrors] = useState<any>({});
  const [loading, setLoading] = useState(false);
  const [serverError, setServerError] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [success, setSuccess] = useState(false);

  const validateForm = () => {
    const newErrors: any = {};
    
    // Full Name validation
    if (!formData.fullName.trim()) {
      newErrors.fullName = "Full name is required";
    } else if (formData.fullName.trim().length < 3) {
      newErrors.fullName = "Name must be at least 3 characters";
    }
    
    // Mobile validation
    const mobileRegex = /^[6-9]\d{9}$/;
    if (!formData.mobile.trim()) {
      newErrors.mobile = "Mobile number is required";
    } else if (!mobileRegex.test(formData.mobile.trim())) {
      newErrors.mobile = "Enter a valid 10-digit Indian mobile number";
    }
    
    // Password validation
    if (!formData.password) {
      newErrors.password = "Password is required";
    } else if (formData.password.length < 6) {
      newErrors.password = "Password must be at least 6 characters";
    }
    
    // Confirm password validation
    if (!formData.confirmPassword) {
      newErrors.confirmPassword = "Please confirm your password";
    } else if (formData.password !== formData.confirmPassword) {
      newErrors.confirmPassword = "Passwords do not match";
    }
    
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const generateReferralCode = () => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    let code = '';
    for (let i = 0; i < 8; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return code;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setServerError("");
    
    if (!validateForm()) {
      return;
    }
    
    setLoading(true);
    
    try {
      // Check if mobile already exists
      const { data: existingUser, error: checkError } = await supabase
        .from("users")
        .select("mobile")
        .eq("mobile", formData.mobile.trim())
        .single();

      if (existingUser) {
        setServerError("This mobile number is already registered. Please login.");
        setLoading(false);
        return;
      }

      // Generate referral code for new user
      const referralCode = generateReferralCode();
      
      // Prepare user data
      const userData = {
        full_name: formData.fullName.trim(),
        mobile: formData.mobile.trim(),
        password: formData.password, // In production, hash this!
        referral_code: referralCode,
        referred_by: formData.referral.trim() || null,
        balance: 10.00, // Signup bonus
        total_earnings: 0.00,
        status: "active",
        created_at: new Date().toISOString(),
        last_login: null,
        is_verified: false,
        verification_token: null,
        token_expires_at: null
      };

      // Insert new user
      const { data, error } = await supabase
        .from("users")
        .insert([userData])
        .select();

      if (error) {
        console.error("Supabase error:", error);
        throw error;
      }

      // If referral code was provided, update referrer's stats
      if (formData.referral.trim()) {
        await supabase
          .from("users")
          .update({
            balance: supabase.rpc('increment', { x: 50 }), // Add ₹50 bonus to referrer
            total_referrals: supabase.rpc('increment', { x: 1 })
          })
          .eq("referral_code", formData.referral.trim());
      }

      // Success!
      setSuccess(true);
      
      // Auto redirect after 3 seconds
      setTimeout(() => {
        router.push("/login");
      }, 3000);

    } catch (error: any) {
      console.error("Registration error:", error);
      setServerError(
        error.message || 
        "Registration failed. Please try again or contact support."
      );
    } finally {
      setLoading(false);
    }
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: value
    }));
    
    // Clear error when user starts typing
    if (errors[name]) {
      setErrors(prev => ({
        ...prev,
        [name]: ""
      }));
    }
  };

  if (success) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 to-blue-950 px-4 py-6">
        <div className="w-full max-w-md bg-gradient-to-b from-green-900/20 to-emerald-900/20 p-8 rounded-2xl text-white shadow-2xl border border-green-800/50 text-center">
          <div className="mb-6">
            <div className="w-20 h-20 bg-gradient-to-r from-green-500 to-emerald-400 rounded-full flex items-center justify-center mx-auto mb-4">
              <CheckCircle className="w-12 h-12" />
            </div>
            <h2 className="text-3xl font-bold text-green-400 mb-2">Registration Successful!</h2>
            <p className="text-gray-300 mb-6">Welcome to DataSell Pro</p>
          </div>
          
          <div className="bg-gray-900/50 p-6 rounded-xl border border-gray-700 mb-6">
            <div className="flex justify-between items-center mb-4">
              <span className="text-gray-400">Your Account:</span>
              <span className="font-bold text-lg">{formData.fullName}</span>
            </div>
            <div className="flex justify-between items-center mb-4">
              <span className="text-gray-400">Mobile:</span>
              <span className="font-mono">+91 {formData.mobile}</span>
            </div>
            <div className="flex justify-between items-center">
              <span className="text-gray-400">Signup Bonus:</span>
              <span className="text-2xl font-bold text-green-400">₹10</span>
            </div>
          </div>

          <div className="bg-gradient-to-r from-green-900/30 to-emerald-900/30 p-4 rounded-xl mb-6">
            <h3 className="font-bold text-green-300 mb-2">🎉 What's Next?</h3>
            <ul className="text-sm text-gray-300 space-y-2 text-left">
              <li className="flex items-center">
                <CheckCircle className="w-4 h-4 text-green-400 mr-2" />
                Login to access your dashboard
              </li>
              <li className="flex items-center">
                <Wallet className="w-4 h-4 text-green-400 mr-2" />
                Start earning from Day 1
              </li>
              <li className="flex items-center">
                <Zap className="w-4 h-4 text-green-400 mr-2" />
                Refer friends & earn ₹50 each
              </li>
            </ul>
          </div>

          <div className="text-sm text-gray-400 mb-6">
            Redirecting to login page in 3 seconds...
          </div>

          <button
            onClick={() => router.push("/login")}
            className="w-full bg-gradient-to-r from-green-600 to-emerald-500 hover:from-green-700 hover:to-emerald-600 transition-all rounded-lg py-3.5 font-bold text-lg"
          >
            Go to Login Now
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 via-blue-950 to-gray-900 px-4 py-6">
      <div className="w-full max-w-md bg-gradient-to-b from-[#111827] to-[#1e293b] p-6 sm:p-8 rounded-2xl text-white shadow-2xl border border-gray-800">
        
        {/* Header */}
        <div className="text-center mb-6">
          <div className="flex items-center justify-center gap-2 mb-2">
            <div className="p-2 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-lg">
              <Wallet className="w-6 h-6" />
            </div>
            <h1 className="text-3xl font-bold bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
              DataSell Pro
            </h1>
          </div>
          
          <p className="text-sm text-cyan-300 font-semibold mb-1">
            🚀 Join 50,000+ Users Earning Daily
          </p>
          
          <div className="inline-flex items-center bg-gradient-to-r from-green-900/40 to-emerald-900/40 text-green-300 px-3 py-1 rounded-full text-xs font-medium border border-green-800/50 mb-4">
            <CheckCircle className="w-3 h-3 mr-1" />
            ₹10 Instant Signup Bonus!
          </div>

          {/* USPs */}
          <div className="grid grid-cols-3 gap-2 mt-4 mb-6">
            <div className="flex flex-col items-center p-2 bg-gray-800/40 rounded-lg">
              <Zap className="w-5 h-5 text-yellow-400 mb-1" />
              <span className="text-xs font-medium">Daily Income</span>
            </div>
            <div className="flex flex-col items-center p-2 bg-gray-800/40 rounded-lg">
              <Wallet className="w-5 h-5 text-green-400 mb-1" />
              <span className="text-xs font-medium">Fast Withdrawal</span>
            </div>
            <div className="flex flex-col items-center p-2 bg-gray-800/40 rounded-lg">
              <Shield className="w-5 h-5 text-blue-400 mb-1" />
              <span className="text-xs font-medium">100% Secure</span>
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div className="flex mb-6 rounded-xl overflow-hidden border border-gray-700 bg-gray-900/50">
          <button
            onClick={() => router.push("/login")}
            className="flex-1 py-3 text-center hover:bg-gray-800/50 transition-colors font-semibold text-gray-300"
            type="button"
          >
            🔐 Login
          </button>
          <button
            disabled
            className="flex-1 py-3 text-center bg-gradient-to-r from-blue-600 to-cyan-500 font-semibold shadow-lg"
            type="button"
          >
            ✨ Create Account
          </button>
        </div>

        {/* Bonus Preview */}
        <div className="mb-6 p-4 bg-gradient-to-r from-blue-900/30 to-cyan-900/30 rounded-xl border border-blue-800/30">
          <div className="flex justify-between items-center">
            <div>
              <p className="text-sm font-medium">Start Earning Today</p>
              <p className="text-xs text-gray-300">Potential daily: ₹200 - ₹500</p>
            </div>
            <div className="text-right">
              <p className="text-lg font-bold text-green-400">₹10</p>
              <p className="text-xs text-gray-300">Signup Bonus</p>
            </div>
          </div>
        </div>

        {/* Registration Form */}
        <form onSubmit={handleSubmit} className="space-y-4">
          {/* Full Name */}
          <div>
            <label htmlFor="fullName" className="block mb-1 font-medium text-sm text-gray-200">
              <User className="inline w-4 h-4 mr-2" />
              Full Name
            </label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              className={`w-full bg-gray-900 border ${errors.fullName ? 'border-red-500' : 'border-gray-700'} p-3 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition`}
              placeholder="Enter your full name"
              value={formData.fullName}
              onChange={handleChange}
              required
              autoComplete="name"
              minLength={3}
              maxLength={100}
            />
            {errors.fullName && (
              <p className="text-red-400 text-xs mt-1">{errors.fullName}</p>
            )}
          </div>

          {/* Mobile Number */}
          <div>
            <label htmlFor="mobile" className="block mb-1 font-medium text-sm text-gray-200">
              <Phone className="inline w-4 h-4 mr-2" />
              Mobile Number
            </label>
            <div className="relative">
              <div className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">+91</div>
              <input
                id="mobile"
                name="mobile"
                type="tel"
                className={`w-full bg-gray-900 border ${errors.mobile ? 'border-red-500' : 'border-gray-700'} pl-12 p-3 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition`}
                placeholder="9876543210"
                value={formData.mobile}
                onChange={handleChange}
                required
                pattern="[6-9]{1}[0-9]{9}"
                maxLength={10}
                inputMode="numeric"
              />
            </div>
            {errors.mobile && (
              <p className="text-red-400 text-xs mt-1">{errors.mobile}</p>
            )}
            <p className="text-gray-400 text-xs mt-1">We'll send OTP to verify</p>
          </div>

          {/* Password */}
          <div>
            <label htmlFor="password" className="block mb-1 font-medium text-sm text-gray-200">
              <Key className="inline w-4 h-4 mr-2" />
              Password
            </label>
            <div className="relative">
              <input
                id="password"
                name="password"
                type={showPassword ? "text" : "password"}
                className={`w-full bg-gray-900 border ${errors.password ? 'border-red-500' : 'border-gray-700'} p-3 pr-10 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition`}
                placeholder="Create a strong password"
                value={formData.password}
                onChange={handleChange}
                required
                minLength={6}
                autoComplete="new-password"
              />
              <button
                type="button"
                className="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-white"
                onClick={() => setShowPassword(!showPassword)}
              >
                {showPassword ? <EyeOff size={20} /> : <Eye size={20} />}
              </button>
            </div>
            {errors.password && (
              <p className="text-red-400 text-xs mt-1">{errors.password}</p>
            )}
            <p className="text-gray-400 text-xs mt-1">Minimum 6 characters</p>
          </div>

          {/* Confirm Password */}
          <div>
            <label htmlFor="confirmPassword" className="block mb-1 font-medium text-sm text-gray-200">
              <Key className="inline w-4 h-4 mr-2" />
              Confirm Password
            </label>
            <div className="relative">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type={showConfirmPassword ? "text" : "password"}
                className={`w-full bg-gray-900 border ${errors.confirmPassword ? 'border-red-500' : 'border-gray-700'} p-3 pr-10 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition`}
                placeholder="Confirm your password"
                value={formData.confirmPassword}
                onChange={handleChange}
                required
                minLength={6}
                autoComplete="new-password"
              />
              <button
                type="button"
                className="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-white"
                onClick={() => setShowConfirmPassword(!showConfirmPassword)}
              >
                {showConfirmPassword ? <EyeOff size={20} /> : <Eye size={20} />}
              </button>
            </div>
            {errors.confirmPassword && (
              <p className="text-red-400 text-xs mt-1">{errors.confirmPassword}</p>
            )}
          </div>

          {/* Referral Code */}
          <div>
            <label htmlFor="referral" className="block mb-1 font-medium text-sm text-gray-200">
              🎁 Referral Code (Optional)
            </label>
            <input
              id="referral"
              name="referral"
              type="text"
              className="w-full bg-gray-900 border border-gray-700 p-3 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
              placeholder="Enter referral code"
              value={formData.referral}
              onChange={handleChange}
              maxLength={20}
            />
            <p className="text-green-400 text-xs mt-1">
              Get ₹50 bonus for you and your friend!
            </p>
          </div>

          {/* Security Badge */}
          <div className="flex items-center justify-center gap-2 p-3 bg-gray-900/40 rounded-lg border border-gray-700">
            <Shield className="w-4 h-4 text-green-400" />
            <span className="text-xs text-gray-300">
              ISO 27001 Certified • 256-bit Encryption • 100% Data Privacy
            </span>
          </div>

          {/* Error Message */}
          {serverError && (
            <div className="p-3 bg-red-900/30 border border-red-800 rounded-lg">
              <p className="text-red-300 text-sm text-center">{serverError}</p>
            </div>
          )}

          {/* Terms & Conditions */}
          <div className="flex items-start">
            <input
              type="checkbox"
              id="terms"
              required
              className="w-4 h-4 mt-1 text-blue-600 bg-gray-700 border-gray-600 rounded focus:ring-blue-500"
            />
            <label htmlFor="terms" className="ml-2 text-xs text-gray-300">
              By creating an account, you agree to our Terms of Service and Privacy Policy. 
              You confirm that you are 18+ years old and all information provided is accurate.
            </label>
          </div>

          {/* Register Button */}
          <button
            type="submit"
            disabled={loading}
            className="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 disabled:opacity-50 transition-all duration-300 rounded-lg py-3.5 font-bold text-lg shadow-lg shadow-blue-900/30 hover:shadow-blue-900/50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-blue-500"
          >
            {loading ? (
              <span className="flex items-center justify-center">
                <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></div>
                Creating Account...
              </span>
            ) : (
              "👉 Create My Account & Get ₹10 Bonus"
            )}
          </button>

          {/* Privacy Note */}
          <p className="text-center text-gray-400 text-xs px-4">
            🔒 Your data is 100% secure and never shared with third parties. 
            <br />
            <span className="text-cyan-300">All transactions are protected by RBI guidelines.</span>
          </p>

          {/* Login Redirect */}
          <div className="text-center pt-4 border-t border-gray-800">
            <p className="text-gray-400">
              Already have an account?{" "}
              <button
                type="button"
                onClick={() => router.push("/login")}
                className="text-blue-400 hover:text-blue-300 font-semibold"
              >
                Login here
              </button>
            </p>
          </div>
        </form>

        {/* Testimonial */}
        <div className="mt-8">
          <h3 className="text-center text-sm font-semibold text-gray-300 mb-3">What Our Users Say</h3>
          <div className="bg-gray-900/40 p-4 rounded-xl border border-gray-700">
            <p className="text-sm text-gray-300">"Started with ₹10 bonus, now earning ₹500 daily! Legit platform."</p>
            <p className="text-xs text-cyan-300 mt-1">- Rajesh, Bangalore</p>
          </div>
        </div>
      </div>
    </div>
  );
}